[user]
	name = Till Hoffmann
	# No global email on purpose: identity comes from the includeIf files below.
	# useConfigOnly makes git ERROR on unset email instead of guessing user@host.
	useConfigOnly = true
[commit]
	gpgsign = false
[init]
	defaultBranch = main
	templateDir = ~/.git-template
[pull]
	rebase = true
[gpg]
	format = ssh
[push]
	autoSetupRemote = true

# config for https://github.com/dandavison/delta, installed via `brew install git-delta`
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
[tag]
	sort = -v:refname

# Identity files
# ~/code/.gitconfig is the default for every repo under ~. A per-org file
# overrides it, because the later include wins. Missing files are no-ops.
[includeIf "gitdir:~/"]
    path = ~/code/.gitconfig
[includeIf "gitdir:~/code/thetillhoff/"]
    path = ~/code/thetillhoff/.gitconfig
[includeIf "gitdir:~/code/cloudastro/"]
    path = ~/code/cloudastro/.gitconfig
