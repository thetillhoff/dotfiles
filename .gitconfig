[user]
	name = Till Hoffmann
	# No global email/signingkey on purpose: commits outside a known org dir
	# must fail until an includeIf below sets an identity.
	# Per-org email+signingkey live in ~/.gitconfigs/<org>.
	# useConfigOnly makes git ERROR on unset email instead of guessing user@host.
	useConfigOnly = true
[commit]
	gpgsign = false
[init]
	defaultBranch = main
	templateDir = ~/.git-template
[pull]
	rebase = true
[gpg]
	format = ssh
[push]
	autoSetupRemote = true

# config for https://github.com/dandavison/delta, installed via `brew install git-delta`
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
[tag]
	sort = -v:refname

# gitconfigs
# Identity lives in a per-machine ~/code/.gitconfig (flat layout) and/or a
# per-owner ~/code/<owner>/.gitconfig. Missing include files are no-ops, so the
# same config works across machines regardless of which layout is present.
[includeIf "gitdir:~/"]
	path = ~/code/.gitconfig
[includeIf "gitdir:~/"]
	path = ~/code/thetillhoff/.gitconfig
[includeIf "gitdir:~/code/thetillhoff/"]
	path = ~/code/thetillhoff/.gitconfig
